{
	"$schema": "https://turbo.build/schema.json",
	"globalPassThroughEnv": ["NEEDS_JSON", "EXTRA_REQUIRED_JOBS"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"@nocoo/bat#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"@bat/ui#build": {
			"dependsOn": ["^build"],
			"outputs": ["../worker/static/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"test:unit:coverage": {
			"dependsOn": ["^build"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"@bat/worker#test:e2e": {
			"dependsOn": ["@bat/ui#build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
