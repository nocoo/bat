{
	"name": "bat",
	"version": "2.3.2",
	"private": true,
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun scripts/environments/launcher.mjs",
		"dev:built": "bun scripts/environments/launcher.mjs --built",
		"demo:reset": "bun scripts/environments/launcher.mjs --reset-demo",
		"release": "bun scripts/release.ts",
		"build": "turbo build --filter=@bat/ui",
		"deploy": "turbo build --filter=@bat/ui && cd packages/worker && npx wrangler deploy --env production",
		"typecheck": "turbo typecheck",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"test": "turbo test && cd probe && cargo test --quiet",
		"test:unit:coverage": "bash scripts/check-coverage.sh",
		"test:e2e:pw": "cd packages/ui && bunx playwright test",
		"gate:routes": "bun run scripts/check-route-coverage.ts",
		"gate:pages": "bun run scripts/check-page-coverage.ts",
		"gate:security": "bun run scripts/run-security.ts",
		"prepare": "husky",
		"test:environments": "bun scripts/environments/verify.mjs",
		"capture:environments": "bun scripts/environments/capture.mjs",
		"test:environments:ui": "bun scripts/environments/capture.mjs --interactive"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"better-sqlite3",
		"esbuild",
		"workerd"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/better-sqlite3": "^9.6.0",
		"@vitest/coverage-v8": "5.0.2",
		"better-sqlite3": "13.0.3",
		"husky": "^9.1.0",
		"lint-staged": "17.6.0",
		"turbo": "2.11.5",
		"typescript": "^7.0.2",
		"vitest": "5.0.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --error-on-warnings --no-errors-on-unmatched"
		]
	},
	"overrides": {
		"esbuild": "0.28.1",
		"nanoid": "^3.3.18",
		"postcss": "8.5.28",
		"sharp": "^0.35.4",
		"undici": "7.29.1",
		"ws": "8.21.0"
	}
}
